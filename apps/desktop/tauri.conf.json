{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talo", "version": "0.1.0", "identifier": "com.talo.desktop",
  "build": { "beforeDevCommand": "npm run dev:ui", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build:ui", "frontendDist": "../ui/dist" },
  "app": { "windows": [{ "label": "main", "title": "Talo", "width": 1100, "height": 760, "minWidth": 760, "minHeight": 580 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.png", "icons/icon.ico"], "resources": { "../../vendor/runtime/node/": "runtime/node/", "../../vendor/runtime/chromium/": "runtime/chromium/", "../../vendor/runtime-manifest.json": "runtime-manifest.json", "../../vendor/bundle/": "bundle/" }, "windows": { "webviewInstallMode": { "type": "offlineInstaller" }, "nsis": { "installMode": "currentUser" } } }
}
