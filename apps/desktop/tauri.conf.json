{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talo",
  "version": "0.1.0",
  "identifier": "com.talo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talo",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 580,
        "theme": "Dark",
        "backgroundColor": "#121211",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../vendor/runtime/bun/": "runtime/bun/",
      "../../vendor/runtime/chromium/": "runtime/chromium/",
      "../../vendor/runtime-manifest.json": "runtime-manifest.json",
      "../../vendor/bundle/": "bundle/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3MkYwQjg4OUU0NTE5OTgKUldTWUdVV2VpQXN2Und2Q1RzQzUxTHJsSTd3KzlPRExyQnBRb0NyVjQ1RENwL294VHp5UXIxZzIK",
      "endpoints": [
        "https://github.com/OWNER/talo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
